---
import '../styles/site.css';
import allPages from '../data/pages.json';
const {title,description,slug='',sections=[],sourcePath='README.md',home=false,notFound=false}=Astro.props;
const ja=slug.startsWith('ja');const prefix=ja?'/ja':'';const canonical='https://kabuforge.com/'+(slug?slug+'/':'');const alt=ja?slug.replace(/^ja\/?/,''):'ja'+(slug?'/'+slug:'');const noindex=import.meta.env.PUBLIC_NOINDEX==='true'||notFound;
const sequence=allPages.filter(p=>p.slug.startsWith('ja/')===ja);const pageIndex=sequence.findIndex(p=>p.slug===slug);const previous=sequence[pageIndex-1];const next=sequence[pageIndex+1];
const schema=home?{'@context':'https://schema.org','@graph':[{'@type':'WebSite','@id':'https://kabuforge.com/#website',name:'KabuForge',url:'https://kabuforge.com/',mentions:{'@type':'WebSite',name:'ArcaViso',url:'https://arcaviso.com/'}},{'@type':'SoftwareSourceCode','@id':'https://kabuforge.com/#software',name:'KabuForge',description:'Open-source, local-first software for Japanese-equity factor and strategy research, backtesting, and local paper simulation.',url:'https://kabuforge.com/',codeRepository:'https://github.com/Siyuan-chat/KabuForge',license:'https://spdx.org/licenses/AGPL-3.0-only.html',programmingLanguage:'Python',version:'0.1.1',isPartOf:{'@id':'https://kabuforge.com/#website'}}]}:{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'KabuForge',item:'https://kabuforge.com'+prefix+'/'},{'@type':'ListItem',position:2,name:title,item:canonical}]};
---
<!doctype html><html lang={ja?'ja':'en'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{home?title:title+' | KabuForge'}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{!notFound&&<><link rel="alternate" hreflang={ja?'ja':'en'} href={canonical}/><link rel="alternate" hreflang={ja?'en':'ja'} href={'https://kabuforge.com/'+(alt?alt+'/':'')}/><link rel="alternate" hreflang="x-default" href={'https://kabuforge.com/'+(ja?slug.replace(/^ja\/?/,''):slug)+(slug&&slug!=='ja'?'/':'')}/></>}{noindex&&<meta name="robots" content="noindex,follow"/>}<link rel="icon" href="/favicon.svg"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://kabuforge.com/images/social.png"/><meta property="og:image:width" content="1280"/><meta property="og:image:height" content="640"/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body>
<a class="skip" href="#main">{ja?'本文へ':'Skip to content'}</a><header><a href={prefix+'/'} aria-label="KabuForge home"><img src="/brand/logo.svg" width="188" height="44" alt="KabuForge"/></a><details class="mobile-menu"><summary>{ja?'メニュー':'Menu'}</summary><nav><a href={prefix+'/docs/'}>{ja?'文書':'Docs'}</a><a href={prefix+'/examples/'}>{ja?'実行例':'Examples'}</a><a href={prefix+'/releases/'}>{ja?'リリース':'Releases'}</a></nav></details><nav class="desktop-nav"><a href={prefix+'/docs/'}>{ja?'ドキュメント':'Docs'}</a><a href={prefix+'/examples/'}>{ja?'実行例':'Examples'}</a><a href={prefix+'/releases/'}>{ja?'リリース':'Releases'}</a></nav><div class="header-end"><a href="https://github.com/Siyuan-chat/KabuForge">GitHub</a>{!notFound&&<a href={'/'+(alt?alt+'/':'')} lang={ja?'en':'ja'}>{ja?'English':'日本語'}</a>}</div></header>
<main id="main" class:list={[home?'home':'document']}>
{!home&&<aside><strong>{ja?'ガイド':'Explore KabuForge'}</strong><nav>{[['docs/quickstart','Quickstart','導入'],['docs/desktop','Desktop','デスクトップ'],['docs/architecture','Architecture','設計'],['docs/methodology','Methodology','方法と制約'],['docs/mcp','MCP','MCP'],['examples/offline-demo','Offline demo','オフラインデモ'],['about','About','プロジェクト'],['releases','Releases','リリース']].map(([p,en,jp])=><a aria-current={slug===prefix.slice(1)+(ja?'/':'')+p?'page':undefined} href={prefix+'/'+p+'/'}>{ja?jp:en}</a>)}</nav></aside>}
<article>{!home&&<><p class="eyebrow">KABUFORGE / v0.1.1</p><h1>{title}</h1><p class="lead">{description}</p><nav class="toc" aria-label={ja?'目次':'On this page'}>{sections.map((s,i)=><a href={'#section-'+i}>{s.title}</a>)}</nav></>}<slot/>{sections.map((s,i)=><section id={'section-'+i}><h2>{s.title}</h2><div set:html={s.body}/></section>)}{!home&&!notFound&&<><div class="source-note"><p>{ja?'対象':'Applies to'}: v0.1.1 · {ja?'公開ソース':'Public source'} <a href={'https://github.com/Siyuan-chat/KabuForge/blob/v0.1.1/'+sourcePath}>{sourcePath}</a></p><p>{ja?'Release タグ':'Release tag'} <code>v0.1.1</code> · {ja?'内容確認':'Reviewed'} 2026-10-04</p></div><nav class="page-nav">{previous&&<a href={'/'+previous.slug+'/'}>{ja?'前へ：':'Previous: '}{previous.title}</a>}{next&&<a href={'/'+next.slug+'/'}>{ja?'次へ：':'Next: '}{next.title}</a>}</nav></>}</article></main>
<footer><div><strong>KabuForge</strong><p>{ja?'日本株のローカル研究とシミュレーション。':'Local research and simulation for Japanese equities.'}</p></div><nav><a href={prefix+'/about/'}>{ja?'プロジェクト':'About'}</a><a href={prefix+'/docs/methodology/'}>{ja?'制約':'Limitations'}</a><a href="https://github.com/Siyuan-chat/KabuForge/issues">Issues</a><a href="https://github.com/Siyuan-chat/KabuForge/blob/v0.1.1/LICENSE">AGPL-3.0-only</a></nav></footer>
<script>document.querySelectorAll('.copy').forEach(button=>button.addEventListener('click',async()=>{const text=button.parentElement?.querySelector('code')?.textContent||'';const status=button.parentElement?.querySelector('.copy-status');try{await navigator.clipboard.writeText(text);if(status)status.textContent=document.documentElement.lang==='ja'?'コピーしました':'Copied';}catch{if(status)status.textContent=document.documentElement.lang==='ja'?'テキストを選択してコピーしてください':'Select the code to copy';}}));</script></body></html>
